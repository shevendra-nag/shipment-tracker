# Copy to .env locally, but never commit your .env file.
# On Docker Compose, .env supplies compose.yaml variable substitutions.
PORT=3000
HOST=127.0.0.1
DATA_DIR=./data

# For HTTPS deployments set true. For local plain HTTP development use false.
COOKIE_SECURE=true
# Required in production: set a private random secret of at least 20 characters.
# Enter this secret once during administrator account setup.
ADMIN_SETUP_KEY=
# Public HTTPS URL without trailing path, used for emailed tracking links.
PUBLIC_BASE_URL=

# Optional live courier tracking - configure after obtaining an AfterShip API key.
AFTERSHIP_API_KEY=
AFTERSHIP_WEBHOOK_SECRET=
TRACKING_SYNC_MINUTES=30

# Optional opt-in status notifications via Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
